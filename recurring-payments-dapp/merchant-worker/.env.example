# Ethereum Sepolia RPC
RPC_URL=https://rpc.sepolia.org

# Private key of the merchant wallet. Never commit a real key.
MERCHANT_PRIVATE_KEY=0xYOUR_MERCHANT_PRIVATE_KEY_HERE

# Deployed RecurringAllowance contract address
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS_HERE

# Merchant recipient address
MERCHANT_ADDRESS=0xYOUR_MERCHANT_WALLET_ADDRESS_HERE
